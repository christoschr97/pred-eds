\newlabel{tab:ablation_results}{{4}{21}{Feature ablation study results sorted by test AUPRC. $\Delta $ indicates change relative to the Full Model (16-feature) baseline. \#F = number of input features. All experiments use Attention-LSTM with identical seeds, hyperparameters, and temporal split}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Events Only versus Full Model test AUPRC across model families. In all cases, removing the twelve network features maintains or improves predictive performance, replicating the network null finding across model architectures.}}{22}{table.5}\protected@file@percent }
